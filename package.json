{
  "name": "remix-core",
  "version": "0.1.0",
  "description": "Domain-agnostic remix engine: stems -> recombine -> pluggable coherence layer. Music matches key+BPM; other domains plug their own rules.",
  "type": "module",
  "license": "MIT",
  "keywords": ["remix", "stems", "composition", "coherence", "engine"],
  "exports": {
    ".": "./src/index.ts",
    "./music": "./src/adapters/music/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "demo": "tsx examples/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
